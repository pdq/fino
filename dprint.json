{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "useTabs": false,
  "lineWidth": 100,
  "json": {
  },
  "markdown": {
  },
  "toml": {
    "comment.forceLeadingSpace": false
  },
  "yaml": {
    "quotes": "preferSingle"
  },
  "excludes": ["vendor/**", "target/**", "evidence/**", "dist/**", "Cargo.lock", "mise.lock"],
  "plugins": [
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.28.2",
    "npm:@dprint/toml@0.9.0",
    "npm:dprint-plugin-yaml@0.6.0"
  ]
}
